        <mxCell id="diagram-title" value="&lt;b&gt;Трейсинг критического пути заказа и контроль прохождения&lt;/b&gt;&lt;br&gt;C4: диаграмма контейнеров" style="text;html=1;whiteSpace=wrap;fontSize=28;fontColor=#333333;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="diagram-legend" value="Красный: новые контейнеры и связи решения. Рамка на БД, RabbitMQ и S3: трассируются клиентские вызовы из API и worker.&lt;br&gt;Зелёный: дополнительный контроль заказа, сверка и уведомления.&lt;br&gt;Связи исходной архитектуры сохранены. MES worker выделяется по плану Task1. Маршрут B2C от магазина до расчёта MES требует уточнения по реализации." style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=3;fontColor=#555555;fontSize=14;align=center;verticalAlign=middle;spacing=10;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="1620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="watch-oncall" value="&lt;b&gt;Дежурный и поддержка&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Ссылка на список инцидентов;&lt;br&gt;order_id только через CRM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;fontColor=#2E7D32;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2750" y="1460" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="watch-notify" source="alertmanager" target="watch-oncall" value="Уведомление" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;fontColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;startArrow=none;">
